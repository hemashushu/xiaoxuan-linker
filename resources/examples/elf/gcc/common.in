// Shared architecture-specific syscall helpers.

#if defined(__x86_64__)
#define SYS_write 1
#define SYS_exit 60

static inline long __syscall1(long nr, long arg1)
{
    long ret;
    __asm__ volatile(
        "syscall"
        : "=a"(ret)
        : "a"(nr),
          "D"(arg1)
        : "rcx", "r11", "memory");
    return ret;
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    long ret;
    __asm__ volatile(
        "syscall"
        : "=a"(ret)
        : "a"(nr),
          "D"(arg1),
          "S"(arg2),
          "d"(arg3)
        : "rcx", "r11", "memory");
    return ret;
}
#elif defined(__aarch64__)
#define SYS_write 64
#define SYS_exit 93

#define __asm_syscall(...) \
    __asm__ volatile(      \
        "svc 0"            \
        : "=r"(x0)         \
        : __VA_ARGS__      \
        : "memory", "cc"); \
    return x0;

static inline long __syscall1(long nr, long arg1)
{
    register long x8 __asm__("x8") = nr;
    register long x0 __asm__("x0") = arg1;
    __asm_syscall("r"(x8), "0"(x0));
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    register long x8 __asm__("x8") = nr;
    register long x0 __asm__("x0") = arg1;
    register long x1 __asm__("x1") = arg2;
    register long x2 __asm__("x2") = arg3;
    __asm_syscall("r"(x8), "0"(x0), "r"(x1), "r"(x2));
}
#elif defined(__riscv)
#define SYS_write 64
#define SYS_exit 93

#define __asm_syscall(...) \
    __asm__ volatile(      \
        "ecall\n\t"        \
        : "=r"(a0)         \
        : __VA_ARGS__      \
        : "memory");       \
    return a0;

static inline long __syscall1(long n, long a)
{
    register long a7 __asm__("a7") = n;
    register long a0 __asm__("a0") = a;
    __asm_syscall("r"(a7), "0"(a0))
}

static inline long __syscall3(long n, long a, long b, long c)
{
    register long a7 __asm__("a7") = n;
    register long a0 __asm__("a0") = a;
    register long a1 __asm__("a1") = b;
    register long a2 __asm__("a2") = c;
    __asm_syscall("r"(a7), "0"(a0), "r"(a1), "r"(a2))
}

// Since current build script uses `-fno-pic -fno-pie -mno-relax` for RISC-V,
// this function has no reference in the current project, but it is kept here for future use.
static inline void init_gp(void)
{
    __asm__ volatile(
        ".option push\n\t"
        ".option norelax\n\t"
        "la gp, __global_pointer$\n\t"
        ".option pop\n\t"
        :
        :
        : "gp");
}
#elif defined(__loongarch64)
#define SYS_write 64
#define SYS_exit 93

static inline long __syscall1(long nr, long arg1)
{
    register long a7 __asm__("a7") = nr;
    register long a0 __asm__("a0") = arg1;
    __asm__ volatile(
        "syscall 0"
        : "+r"(a0)
        : "r"(a7)
        : "memory");
    return a0;
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    register long a7 __asm__("a7") = nr;
    register long a0 __asm__("a0") = arg1;
    register long a1 __asm__("a1") = arg2;
    register long a2 __asm__("a2") = arg3;
    __asm__ volatile(
        "syscall 0"
        : "+r"(a0)
        : "r"(a7), "r"(a1), "r"(a2)
        : "memory");
    return a0;
}
#elif defined(__powerpc64__)
#define SYS_write 4
#define SYS_exit 1

static inline long __syscall1(long nr, long arg1)
{
    register long r0 __asm__("r0") = nr;
    register long r3 __asm__("r3") = arg1;
    __asm__ volatile(
        "sc"
        : "+r"(r3)
        : "r"(r0)
        : "memory", "cr0");
    return r3;
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    register long r0 __asm__("r0") = nr;
    register long r3 __asm__("r3") = arg1;
    register long r4 __asm__("r4") = arg2;
    register long r5 __asm__("r5") = arg3;
    __asm__ volatile(
        "sc"
        : "+r"(r3)
        : "r"(r0), "r"(r4), "r"(r5)
        : "memory", "cr0");
    return r3;
}
#elif defined(__s390x__)
#define SYS_write 4
#define SYS_exit 1

static inline long __syscall1(long nr, long arg1)
{
    register long r1 __asm__("r1") = nr;
    register long r2 __asm__("r2") = arg1;
    __asm__ volatile(
        "svc 0"
        : "+r"(r2)
        : "r"(r1)
        : "memory");
    return r2;
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    register long r1 __asm__("r1") = nr;
    register long r2 __asm__("r2") = arg1;
    register long r3 __asm__("r3") = arg2;
    register long r4 __asm__("r4") = arg3;
    __asm__ volatile(
        "svc 0"
        : "+r"(r2)
        : "r"(r1), "r"(r3), "r"(r4)
        : "memory");
    return r2;
}
#else
#error "Unsupported architecture"
#endif

[[noreturn]]
static inline void exit(int status)
{
    (void)__syscall1(SYS_exit, (long)status);

    for (;;)
    {
    }
}

static inline long write(int fd, const void *buffer, long size)
{
    return __syscall3(
        SYS_write,
        (long)fd,
        (long)buffer,
        size);
}
