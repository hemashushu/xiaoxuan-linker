// Shared architecture-specific syscall helpers.
//
// Ported from resources/examples/elf/gcc/common.in (Linux) to macOS.
// macOS (XNU/Darwin) uses the BSD syscall ABI, which differs from Linux:
// - The syscall number is placed in x16 (not x8/rax/a7/...), ORed with the
//   "Unix/BSD" syscall class bit `0x2000000`.
// - The trap instruction is `svc 0x80` (arm64) instead of `svc 0`.
// - Only arm64 (Apple Silicon) is supported; there is no need to branch on
//   multiple architectures as in the ELF version.

#if defined(__aarch64__)
#define SYS_write 4
#define SYS_exit 1
#define SYSCALL_CLASS_UNIX 0x2000000

static inline long __syscall1(long nr, long arg1)
{
    register long x16 __asm__("x16") = SYSCALL_CLASS_UNIX | nr;
    register long x0 __asm__("x0") = arg1;
    __asm__ volatile(
        "svc 0x80"
        : "+r"(x0)
        : "r"(x16)
        : "memory", "cc");
    return x0;
}

static inline long __syscall3(long nr, long arg1, long arg2, long arg3)
{
    register long x16 __asm__("x16") = SYSCALL_CLASS_UNIX | nr;
    register long x0 __asm__("x0") = arg1;
    register long x1 __asm__("x1") = arg2;
    register long x2 __asm__("x2") = arg3;
    __asm__ volatile(
        "svc 0x80"
        : "+r"(x0)
        : "r"(x16), "r"(x1), "r"(x2)
        : "memory", "cc");
    return x0;
}
#else
#error "Unsupported architecture (only aarch64/Apple Silicon is supported)"
#endif

[[noreturn]]
static inline void exit(int status)
{
    (void)__syscall1(SYS_exit, (long)status);

    for (;;)
    {
    }
}

static inline long write(int fd, const void *buffer, long size)
{
    return __syscall3(
        SYS_write,
        (long)fd,
        (long)buffer,
        size);
}
